HAZBIT_TELEGRAM_BOTS__REQUIRED_CHANNEL_ID=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_CHAT_IDS=[]
HAZBIT_AUTH__EMAIL__BACKEND=console
HAZBIT_AUTH__EMAIL__FROM_ADDRESS=no-reply@example.com
HAZBIT_AUTH__EMAIL__FROM_NAME=Hazbit
HAZBIT_AUTH__EMAIL__SMTP_HOST=
HAZBIT_AUTH__EMAIL__SMTP_PORT=587
HAZBIT_AUTH__EMAIL__SMTP_USERNAME=
HAZBIT_AUTH__EMAIL__SMTP_PASSWORD=
HAZBIT_AUTH__EMAIL__SMTP_START_TLS=true
HAZBIT_AUTH__EMAIL__SMTP_USE_TLS=false
HAZBIT_AUTH__COOKIES__SECURE=false
HAZBIT_LAUNCH__SUPER_ADMIN_EMAIL=
HAZBIT_LAUNCH__PLAN_PRICES=[]
HAZBIT_VPN__ADAPTER__BASE_URL=http://127.0.0.1:8010
HAZBIT_VPN__ADAPTER__INTERNAL_TOKEN=local-internal-token-change-me
HAZBIT_VPN__ADAPTER__ALLOW_INSECURE_PRIVATE_URL=false
HAZBIT_VPN__ADAPTER__CONNECT_TIMEOUT_SECONDS=2
HAZBIT_VPN__ADAPTER__READ_TIMEOUT_SECONDS=10
HAZBIT_VPN__SUBSCRIPTION_URL_SECRET=local-only-subscription-url-secret-change-me
HAZBIT_VPN__COMMAND_MAX_ATTEMPTS=8
HAZBIT_VPN__COMMAND_LOCK_TIMEOUT_SECONDS=300
HAZBIT_VPN__COMMAND_POLL_INTERVAL_SECONDS=1
HAZBIT_VPN__RETRY_BASE_SECONDS=5
HAZBIT_VPN__RETRY_MAX_SECONDS=3600
HAZBIT_PAYMENTS__GEMINI__API_KEY=
HAZBIT_PAYMENTS__GEMINI__MODEL=gemini-2.5-flash
HAZBIT_PAYMENTS__GEMINI__PROMPT_VERSION=payment-receipt-v1
HAZBIT_PAYMENTS__GEMINI__TIMEOUT_SECONDS=30
HAZBIT_PAYMENTS__EXPECTED_RECIPIENT=HAZBIT VPN
HAZBIT_PAYMENTS__STORAGE__BACKEND=local
