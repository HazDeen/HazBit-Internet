HAZBIT_TELEGRAM_BOTS__OPERATIONS_BOT_TOKEN=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_WEBHOOK_SECRET=local-operations-webhook-secret
HAZBIT_TELEGRAM_BOTS__CALLBACK_SECRET=local-only-bot-callback-secret-change-me-0123456789
HAZBIT_TELEGRAM_BOTS__WEBHOOK_BASE_URL=http://127.0.0.1:8000
HAZBIT_TELEGRAM_BOTS__MINI_APP_URL=http://127.0.0.1:5175
