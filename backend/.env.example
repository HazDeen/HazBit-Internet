HAZBIT_PAYMENTS__STORAGE__ACCESS_KEY_ID=
HAZBIT_PAYMENTS__STORAGE__SECRET_ACCESS_KEY=
HAZBIT_PAYMENTS__MAX_UPLOAD_BYTES=8388608
HAZBIT_PAYMENTS__MAX_IMAGE_PIXELS=20000000
