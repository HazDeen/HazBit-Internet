HAZBIT_ENVIRONMENT=local
HAZBIT_DEBUG=true
HAZBIT_LOG_LEVEL=INFO
HAZBIT_LOG_FORMAT=console
HAZBIT_DOCS_ENABLED=true
HAZBIT_ALLOWED_HOSTS=["localhost","127.0.0.1"]
HAZBIT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HAZBIT_DATABASE__URL=postgresql+asyncpg://hazbit:hazbit@localhost:5432/hazbit_vpn
HAZBIT_DATABASE__ECHO=false
HAZBIT_DATABASE__POOL_SIZE=10
HAZBIT_DATABASE__MAX_OVERFLOW=20
HAZBIT_DATABASE__POOL_TIMEOUT_SECONDS=10
HAZBIT_DATABASE__COMMAND_TIMEOUT_SECONDS=10
HAZBIT_REDIS__URL=redis://localhost:6379/0
HAZBIT_REDIS__KEY_PREFIX=hazbit
HAZBIT_AUTH__JWT__SECRET=local-only-jwt-secret-change-me-0123456789
HAZBIT_AUTH__OTP__SECRET=local-only-otp-secret-change-me-0123456789
HAZBIT_AUTH__REFRESH_TOKEN_SECRET=local-only-refresh-secret-change-me-0123456789
HAZBIT_AUTH__FINGERPRINT_SECRET=local-only-fingerprint-secret-change-me-0123456789
HAZBIT_AUTH__TELEGRAM__BOT_TOKEN=
