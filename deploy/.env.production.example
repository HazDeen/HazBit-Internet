# Public DNS. Create A/AAAA records for the root, admin, app, mini and api hosts.
HAZBIT_DOMAIN=hazdeen.xyz
CADDY_ACME_EMAIL=ops@hazdeen.xyz

# Standalone VPS defaults are 0.0.0.0:80/443 with deploy/Caddyfile. If the VPS
# already has a host Caddy, use the four values below instead:
# HAZBIT_CADDYFILE=./deploy/Caddyfile.internal
# HAZBIT_CADDY_BIND_ADDRESS=127.0.0.1
# HAZBIT_CADDY_HTTP_PORT=18080
# HAZBIT_CADDY_HTTPS_PORT=18443

# Public project identity shown in bank-review pages. Use the actual legal
# individual/company name and working support contacts before launch.
VITE_LEGAL_PROJECT_NAME=Hazbit VPN
VITE_LEGAL_OPERATOR_NAME=ИП Фамилия Имя Отчество
VITE_SUPPORT_EMAIL=support@hazdeen.xyz
VITE_SUPPORT_TELEGRAM=@hazbit_support

# Infrastructure credentials. Use URL-safe values or percent-encode them in URLs below.
POSTGRES_DB=hazbit_vpn
POSTGRES_USER=hazbit
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=hazbit-storage
MINIO_ROOT_PASSWORD=change-this-minio-password
HAZBIT_PAYMENT_BUCKET=hazbit-payment-evidence

# Core API
HAZBIT_ENVIRONMENT=production
HAZBIT_DEBUG=false
HAZBIT_DOCS_ENABLED=false
HAZBIT_LOG_LEVEL=INFO
HAZBIT_LOG_FORMAT=json
HAZBIT_ALLOWED_HOSTS=["hazdeen.xyz","admin.hazdeen.xyz","app.hazdeen.xyz","mini.hazdeen.xyz","api.hazdeen.xyz","127.0.0.1","localhost"]
HAZBIT_CORS_ORIGINS=["https://hazdeen.xyz","https://admin.hazdeen.xyz","https://app.hazdeen.xyz","https://mini.hazdeen.xyz"]
HAZBIT_DATABASE__URL=postgresql+asyncpg://hazbit:change-this-postgres-password@postgres:5432/hazbit_vpn
HAZBIT_DATABASE__POOL_SIZE=20
HAZBIT_DATABASE__MAX_OVERFLOW=20
HAZBIT_REDIS__URL=redis://:change-this-redis-password@redis:6379/0
HAZBIT_REDIS__KEY_PREFIX=hazbit
HAZBIT_API_WORKERS=2
HAZBIT_MIGRATION_MAX_ATTEMPTS=30

# Authentication and email OTP. Generate independent random secrets (at least 32 bytes).
HAZBIT_AUTH__JWT__SECRET=local-only-replace-with-random-jwt-secret
HAZBIT_AUTH__OTP__SECRET=local-only-replace-with-random-otp-secret
HAZBIT_AUTH__REFRESH_TOKEN_SECRET=local-only-replace-with-random-refresh-secret
HAZBIT_AUTH__FINGERPRINT_SECRET=local-only-replace-with-random-fingerprint-secret
HAZBIT_AUTH__TELEGRAM__BOT_TOKEN=
HAZBIT_AUTH__EMAIL__BACKEND=smtp
HAZBIT_AUTH__EMAIL__FROM_ADDRESS=no-reply@hazdeen.xyz
HAZBIT_AUTH__EMAIL__FROM_NAME=Hazbit
HAZBIT_AUTH__EMAIL__SMTP_HOST=smtp.example.com
HAZBIT_AUTH__EMAIL__SMTP_PORT=587
HAZBIT_AUTH__EMAIL__SMTP_USERNAME=
HAZBIT_AUTH__EMAIL__SMTP_PASSWORD=
HAZBIT_AUTH__EMAIL__SMTP_START_TLS=true
HAZBIT_AUTH__EMAIL__SMTP_USE_TLS=false
HAZBIT_AUTH__EMAIL__INVITATION_SECRET=local-only-replace-with-random-staff-invitation-secret
HAZBIT_AUTH__EMAIL__INVITATION_URL="https://admin.hazdeen.xyz/#staff-invite"
HAZBIT_AUTH__COOKIES__SECURE=true
HAZBIT_AUTH__COOKIES__DOMAIN=.hazdeen.xyz
HAZBIT_AUTH__COOKIES__SAME_SITE=lax

# Deployment feature availability. Control can pause an enabled module at runtime,
# but it cannot enable a module set to false here.
HAZBIT_FEATURES__VPN_PROVISIONING=true
HAZBIT_FEATURES__BILLING=true
HAZBIT_FEATURES__PAYMENT_AI=true
HAZBIT_FEATURES__REFERRALS=true
HAZBIT_FEATURES__PROMOTIONS=true
HAZBIT_FEATURES__FAMILIES=true
HAZBIT_FEATURES__SUPPORT=true
HAZBIT_FEATURES__TELEGRAM_BOTS=true

# First-run bootstrap. Prices are minor currency units: 49900 = 499.00 RUB.
# Add at least one real price for each plan before launch; an empty list is rejected.
HAZBIT_LAUNCH__SUPER_ADMIN_EMAIL=owner@hazdeen.xyz
HAZBIT_LAUNCH__PLAN_PRICES=[]

# Remnawave adapter. The backend-to-adapter URL is injected by Compose.
HAZBIT_VPN__ADAPTER__INTERNAL_TOKEN=local-replace-with-shared-random-adapter-token
HAZBIT_VPN__SUBSCRIPTION_URL_SECRET=local-only-replace-with-random-subscription-secret
REMNAWAVE_ADAPTER_ENVIRONMENT=production
REMNAWAVE_ADAPTER_PANEL_BASE_URL=https://remnawave.example.com
REMNAWAVE_ADAPTER_PANEL_TOKEN=local-replace-with-real-remnawave-token
REMNAWAVE_ADAPTER_INTERNAL_TOKEN=local-replace-with-shared-random-adapter-token

# Gemini receipt analysis and S3-compatible evidence storage.
HAZBIT_PAYMENTS__GEMINI__API_KEY=
HAZBIT_PAYMENTS__GEMINI__MODEL=gemini-2.5-flash
HAZBIT_PAYMENTS__EXPECTED_RECIPIENT=HAZBIT VPN
HAZBIT_PAYMENTS__STORAGE__BACKEND=s3
HAZBIT_PAYMENTS__STORAGE__REGION=us-east-1

# Real wallet top-ups through Platega. Callback URL in the Platega cabinet:
# https://api.hazdeen.xyz/api/v1/billing/platega/webhook
HAZBIT_BILLING__CURRENCY=RUB
HAZBIT_BILLING__MINIMUM_TOP_UP_MINOR=10000
HAZBIT_BILLING__MAXIMUM_TOP_UP_MINOR=100000000
HAZBIT_BILLING__RENEWAL_POLL_INTERVAL_SECONDS=30
HAZBIT_BILLING__RENEWAL_RETRY_SECONDS=3600
HAZBIT_BILLING__PLATEGA__ENABLED=true
HAZBIT_BILLING__PLATEGA__BASE_URL=https://app.platega.io
HAZBIT_BILLING__PLATEGA__MERCHANT_ID=
HAZBIT_BILLING__PLATEGA__SECRET=
HAZBIT_BILLING__PLATEGA__SUCCESS_URL="https://app.hazdeen.xyz/#billing/success"
HAZBIT_BILLING__PLATEGA__FAILED_URL="https://app.hazdeen.xyz/#billing/failed"
HAZBIT_BILLING__PLATEGA__ALLOWED_PAYMENT_METHODS=[2,10,13]

# Customer bot and operations bot.
HAZBIT_CONFIGURE_TELEGRAM_WEBHOOKS=true
HAZBIT_TELEGRAM_BOTS__CUSTOMER_WEBHOOK_SECRET=local-replace-with-random-customer-webhook-secret
HAZBIT_TELEGRAM_BOTS__OPERATIONS_BOT_TOKEN=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_WEBHOOK_SECRET=local-replace-with-random-operations-webhook-secret
HAZBIT_TELEGRAM_BOTS__CALLBACK_SECRET=local-only-replace-with-random-callback-secret
HAZBIT_TELEGRAM_BOTS__WEBHOOK_BASE_URL=https://api.hazdeen.xyz
HAZBIT_TELEGRAM_BOTS__MINI_APP_URL=https://mini.hazdeen.xyz
HAZBIT_TELEGRAM_BOTS__ADMIN_APP_URL=https://admin.hazdeen.xyz
HAZBIT_TELEGRAM_BOTS__REQUIRED_CHANNEL_ID=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_CHAT_IDS=[-1001234567890]

# Referral links.
HAZBIT_REFERRALS__DEFAULT_PLAN_SLUG=basic
HAZBIT_REFERRALS__SHARE_URL_PREFIX=https://t.me/hazbit_bot?start=ref_
