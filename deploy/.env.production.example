# Public DNS. Create A/AAAA records for the root, admin, app and api hosts.
HAZBIT_DOMAIN=example.com
CADDY_ACME_EMAIL=ops@example.com

# Infrastructure credentials. Use URL-safe values or percent-encode them in URLs below.
POSTGRES_DB=hazbit_vpn
POSTGRES_USER=hazbit
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=hazbit-storage
MINIO_ROOT_PASSWORD=change-this-minio-password
HAZBIT_PAYMENT_BUCKET=hazbit-payment-evidence

# Core API
HAZBIT_ENVIRONMENT=production
HAZBIT_DEBUG=false
HAZBIT_DOCS_ENABLED=false
HAZBIT_LOG_LEVEL=INFO
HAZBIT_LOG_FORMAT=json
HAZBIT_ALLOWED_HOSTS=["example.com","admin.example.com","app.example.com","api.example.com","127.0.0.1","localhost"]
HAZBIT_CORS_ORIGINS=["https://example.com","https://admin.example.com","https://app.example.com"]
HAZBIT_DATABASE__URL=postgresql+asyncpg://hazbit:change-this-postgres-password@postgres:5432/hazbit_vpn
HAZBIT_DATABASE__POOL_SIZE=20
HAZBIT_DATABASE__MAX_OVERFLOW=20
HAZBIT_REDIS__URL=redis://:change-this-redis-password@redis:6379/0
HAZBIT_REDIS__KEY_PREFIX=hazbit
HAZBIT_API_WORKERS=2
HAZBIT_MIGRATION_MAX_ATTEMPTS=30

# Authentication and email OTP. Generate independent random secrets (at least 32 bytes).
HAZBIT_AUTH__JWT__SECRET=local-only-replace-with-random-jwt-secret
HAZBIT_AUTH__OTP__SECRET=local-only-replace-with-random-otp-secret
HAZBIT_AUTH__REFRESH_TOKEN_SECRET=local-only-replace-with-random-refresh-secret
HAZBIT_AUTH__FINGERPRINT_SECRET=local-only-replace-with-random-fingerprint-secret
HAZBIT_AUTH__TELEGRAM__BOT_TOKEN=
HAZBIT_AUTH__EMAIL__BACKEND=smtp
HAZBIT_AUTH__EMAIL__FROM_ADDRESS=no-reply@example.com
HAZBIT_AUTH__EMAIL__SMTP_HOST=smtp.example.com
HAZBIT_AUTH__EMAIL__SMTP_PORT=587
HAZBIT_AUTH__EMAIL__SMTP_USERNAME=
HAZBIT_AUTH__EMAIL__SMTP_PASSWORD=
HAZBIT_AUTH__EMAIL__SMTP_START_TLS=true
HAZBIT_AUTH__COOKIES__SECURE=true
HAZBIT_AUTH__COOKIES__DOMAIN=.example.com
HAZBIT_AUTH__COOKIES__SAME_SITE=lax

# Remnawave adapter. The backend-to-adapter URL is injected by Compose.
HAZBIT_VPN__ADAPTER__INTERNAL_TOKEN=local-replace-with-shared-random-adapter-token
HAZBIT_VPN__SUBSCRIPTION_URL_SECRET=local-only-replace-with-random-subscription-secret
REMNAWAVE_ADAPTER_ENVIRONMENT=production
REMNAWAVE_ADAPTER_PANEL_BASE_URL=https://remnawave.example.com
REMNAWAVE_ADAPTER_PANEL_TOKEN=local-replace-with-real-remnawave-token
REMNAWAVE_ADAPTER_INTERNAL_TOKEN=local-replace-with-shared-random-adapter-token

# Gemini receipt analysis and S3-compatible evidence storage.
HAZBIT_PAYMENTS__GEMINI__API_KEY=
HAZBIT_PAYMENTS__GEMINI__MODEL=gemini-2.5-flash
HAZBIT_PAYMENTS__EXPECTED_RECIPIENT=HAZBIT VPN
HAZBIT_PAYMENTS__STORAGE__BACKEND=s3
HAZBIT_PAYMENTS__STORAGE__REGION=us-east-1

# Customer bot and operations bot.
HAZBIT_CONFIGURE_TELEGRAM_WEBHOOKS=true
HAZBIT_TELEGRAM_BOTS__CUSTOMER_WEBHOOK_SECRET=local-replace-with-random-customer-webhook-secret
HAZBIT_TELEGRAM_BOTS__OPERATIONS_BOT_TOKEN=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_WEBHOOK_SECRET=local-replace-with-random-operations-webhook-secret
HAZBIT_TELEGRAM_BOTS__CALLBACK_SECRET=local-only-replace-with-random-callback-secret
HAZBIT_TELEGRAM_BOTS__WEBHOOK_BASE_URL=https://api.example.com
HAZBIT_TELEGRAM_BOTS__MINI_APP_URL=https://app.example.com
HAZBIT_TELEGRAM_BOTS__ADMIN_APP_URL=https://admin.example.com
HAZBIT_TELEGRAM_BOTS__REQUIRED_CHANNEL_ID=
HAZBIT_TELEGRAM_BOTS__OPERATIONS_CHAT_IDS=[-1001234567890]

# Referral links.
HAZBIT_REFERRALS__DEFAULT_PLAN_SLUG=basic
HAZBIT_REFERRALS__SHARE_URL_PREFIX=https://t.me/hazbit_bot?start=ref_
